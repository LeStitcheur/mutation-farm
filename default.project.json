{
	"name": "MutationFarm",
	"tree": {
		"$className": "DataModel",
		"ReplicatedStorage": {
			"Shared": {
				"$path": "src/shared"
			}
		},
		"ServerScriptService": {
			"Server": {
				"$path": "src/server"
			}
		},
		"StarterPlayer": {
			"$properties": {
				"CameraMaxZoomDistance": 90
			},
			"StarterPlayerScripts": {
				"Client": {
					"$path": "src/client"
				}
			}
		},
		"Players": {
			"$properties": {
				"CharacterAutoLoads": true
			}
		},
		"Workspace": {
			"$properties": {
				"StreamingEnabled": false
			},
			"Baseplate": {
				"$className": "Part",
				"$properties": {
					"Anchored": true,
					"Locked": true,
					"Size": [1024, 4, 1024],
					"CFrame": { "CFrame": { "position": [0, -2, 0], "orientation": [[1, 0, 0], [0, 1, 0], [0, 0, 1]] } },
					"Color": [0.45, 0.7, 0.34],
					"Material": "Grass",
					"TopSurface": "Smooth",
					"BottomSurface": "Smooth"
				}
			},
			"SpawnLocation": {
				"$className": "SpawnLocation",
				"$properties": {
					"Anchored": true,
					"Size": [10, 1, 10],
					"CFrame": { "CFrame": { "position": [0, 0.5, 0], "orientation": [[1, 0, 0], [0, 1, 0], [0, 0, 1]] } },
					"Duration": 0,
					"Neutral": true,
					"Color": [0.95, 0.85, 0.55],
					"Material": "SmoothPlastic",
					"TopSurface": "Smooth"
				}
			}
		},
		"TextChatService": {
			"$properties": {
				"ChatVersion": "TextChatService"
			}
		},
		"Lighting": {
			"$properties": {
				"ClockTime": 14.5,
				"Brightness": 2.5,
				"Ambient": [0.45, 0.42, 0.5],
				"OutdoorAmbient": [0.55, 0.55, 0.6],
				"GlobalShadows": true,
				"EnvironmentDiffuseScale": 0.5,
				"EnvironmentSpecularScale": 0.5
			},
			"Atmosphere": {
				"$className": "Atmosphere",
				"$properties": {
					"Density": 0.28,
					"Offset": 0.2,
					"Color": [0.78, 0.86, 0.95],
					"Decay": [0.95, 0.75, 0.6],
					"Glare": 0.2,
					"Haze": 1
				}
			},
			"Bloom": {
				"$className": "BloomEffect",
				"$properties": {
					"Intensity": 0.6,
					"Size": 28,
					"Threshold": 1.6
				}
			},
			"ColorCorrection": {
				"$className": "ColorCorrectionEffect",
				"$properties": {
					"Saturation": 0.15,
					"Contrast": 0.05
				}
			}
		}
	}
}
