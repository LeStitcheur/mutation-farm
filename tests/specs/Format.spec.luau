return function()
	local ReplicatedStorage = game:GetService("ReplicatedStorage")
	local Format = require(ReplicatedStorage.Shared.Util.Format)
	local BigNum = require(ReplicatedStorage.Shared.Util.BigNum)

	describe("Format.number", function()
		it("affiche les petits nombres en entier", function()
			expect(Format.number(0)).to.equal("0")
			expect(Format.number(7)).to.equal("7")
			expect(Format.number(999)).to.equal("999")
		end)

		it("applique les suffixes en tronquant", function()
			expect(Format.number(1000)).to.equal("1.00K")
			expect(Format.number(1999)).to.equal("1.99K")
			expect(Format.number(2300)).to.equal("2.30K")
			expect(Format.number(12345)).to.equal("12.3K")
			expect(Format.number(123456)).to.equal("123K")
			expect(Format.number(999999)).to.equal("999K")
			expect(Format.number(1e6)).to.equal("1.00M")
			expect(Format.number(10000000)).to.equal("10.0M")
		end)

		it("formate les négatifs", function()
			expect(Format.number(-1500)).to.equal("-1.50K")
			expect(Format.number(-42)).to.equal("-42")
		end)
	end)

	describe("Format.bigNum", function()
		it("couvre les suffixes jusqu'à Vg", function()
			expect(Format.bigNum(BigNum.fromLog10(15))).to.equal("1.00Qa")
			expect(Format.bigNum(BigNum.fromLog10(33))).to.equal("1.00Dc")
			expect(Format.bigNum(BigNum.fromLog10(63))).to.equal("1.00Vg")
		end)

		it("bascule en notation scientifique au-delà", function()
			expect(Format.bigNum(BigNum.fromLog10(66))).to.equal("1.00e66")
			expect(Format.bigNum(BigNum.fromLog10(300))).to.equal("1.00e300")
		end)
	end)

	describe("Format.duration", function()
		it("formate secondes, minutes et heures", function()
			expect(Format.duration(6)).to.equal("6 s")
			expect(Format.duration(90)).to.equal("1 min 30 s")
			expect(Format.duration(120)).to.equal("2 min")
			expect(Format.duration(3600)).to.equal("1 h")
			expect(Format.duration(3720)).to.equal("1 h 02 min")
			expect(Format.duration(-5)).to.equal("0 s")
		end)
	end)
end
