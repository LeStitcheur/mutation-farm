return function()
	local ReplicatedStorage = game:GetService("ReplicatedStorage")
	local BigNum = require(ReplicatedStorage.Shared.Util.BigNum)

	local function n(x)
		return BigNum.fromNumber(x)
	end

	describe("normalisation", function()
		it("représente zéro de façon canonique", function()
			local zero = BigNum.zero()
			expect(zero.m).to.equal(0)
			expect(zero.e).to.equal(0)
			expect(BigNum.isValid(zero)).to.equal(true)
		end)

		it("conserve exactement les entiers sous 1e15", function()
			local value = n(123456789012345)
			expect(value.m).to.equal(123456789012345)
			expect(value.e).to.equal(0)
		end)

		it("tronque les fractions vers zéro", function()
			expect(n(9.99).m).to.equal(9)
			expect(n(-9.99).m).to.equal(-9)
			expect(BigNum.isZero(n(0.4))).to.equal(true)
		end)

		it("normalise au-delà de 1e15 sur 15 chiffres significatifs", function()
			local value = n(1e15)
			expect(value.m).to.equal(1e14)
			expect(value.e).to.equal(1)
			expect(BigNum.isValid(value)).to.equal(true)
		end)

		it("décompose exactement les grands doubles", function()
			local value = n(1e300)
			expect(value.m).to.equal(1e14)
			expect(value.e).to.equal(286)
		end)

		it("absorbe le bruit flottant des multiplications", function()
			expect(BigNum.mulNumber(n(45), 1.2).m).to.equal(54)
			expect(BigNum.mulNumber(n(10), 1.1).m).to.equal(11)
		end)

		it("rejette les valeurs non finies", function()
			expect(function()
				BigNum.fromNumber(math.huge)
			end).to.throw()
			expect(function()
				BigNum.fromNumber(0 / 0)
			end).to.throw()
		end)
	end)

	describe("arithmétique exacte sous 1e15", function()
		it("additionne exactement", function()
			local value = BigNum.add(n(999999999999998), n(1))
			expect(value.m).to.equal(999999999999999)
			expect(value.e).to.equal(0)
		end)

		it("franchit 1e15 sans perte significative", function()
			local value = BigNum.add(n(999999999999999), n(1))
			expect(BigNum.eq(value, n(1e15))).to.equal(true)
		end)

		it("soustrait exactement", function()
			expect(BigNum.sub(n(1000), n(1)).m).to.equal(999)
			expect(BigNum.isZero(BigNum.sub(n(5), n(5)))).to.equal(true)
			expect(BigNum.sub(n(3), n(10)).m).to.equal(-7)
		end)

		it("multiplie exactement", function()
			expect(BigNum.mul(n(12345), n(6789)).m).to.equal(83810205)
		end)

		it("accumule 100 000 gains de 7 sans dérive", function()
			local total = BigNum.zero()
			local seven = n(7)
			for _ = 1, 100000 do
				total = BigNum.add(total, seven)
			end
			expect(total.m).to.equal(700000)
			expect(total.e).to.equal(0)
		end)
	end)

	describe("grands nombres", function()
		it("ne déborde pas au-delà de 1e308", function()
			local big = BigNum.mul(n(1e300), n(1e300))
			expect(BigNum.isValid(big)).to.equal(true)
			expect(BigNum.log10(big)).to.be.near(600, 1e-9)
		end)

		it("gère un facteur numérique énorme", function()
			local value = BigNum.mulNumber(n(1e300), 1e300)
			expect(BigNum.isValid(value)).to.equal(true)
			expect(BigNum.log10(value)).to.be.near(600, 1e-9)
		end)

		it("ignore les ajouts négligeables", function()
			local big = BigNum.fromLog10(100)
			expect(BigNum.eq(BigNum.add(big, n(1)), big)).to.equal(true)
		end)

		it("conserve 15 chiffres significatifs", function()
			local value = BigNum.add(BigNum.fromLog10(30), BigNum.fromLog10(16))
			expect(value.m).to.equal(100000000000001)
			expect(value.e).to.equal(16)
		end)

		it("renormalise après une soustraction qui réduit l'ordre de grandeur", function()
			local a = BigNum.add(BigNum.fromLog10(20), BigNum.fromLog10(14))
			local diff = BigNum.sub(a, BigNum.fromLog10(20))
			expect(BigNum.isValid(diff)).to.equal(true)
			expect(diff.m).to.equal(1e14)
			expect(diff.e).to.equal(0)
		end)
	end)

	describe("comparaison", function()
		it("ordonne des exposants différents", function()
			expect(BigNum.lt(n(999999999999999), n(1e15))).to.equal(true)
			expect(BigNum.gt(BigNum.fromLog10(20), BigNum.fromLog10(19))).to.equal(true)
			expect(BigNum.gte(n(42), n(42))).to.equal(true)
			expect(BigNum.lte(n(41), n(42))).to.equal(true)
		end)

		it("gère les signes", function()
			expect(BigNum.lt(n(-5), n(3))).to.equal(true)
			expect(BigNum.lt(n(-50), n(-5))).to.equal(true)
			expect(BigNum.compare(n(0), n(0))).to.equal(0)
			expect(BigNum.lt(BigNum.negate(BigNum.fromLog10(20)), n(-1))).to.equal(true)
		end)

		it("max et min", function()
			expect(BigNum.max(n(3), n(9)).m).to.equal(9)
			expect(BigNum.min(n(3), n(9)).m).to.equal(3)
		end)
	end)

	describe("formules et conversions", function()
		it("fromLog10 est exact pour les puissances entières", function()
			expect(BigNum.fromLog10(7).m).to.equal(1e7)
			expect(BigNum.isZero(BigNum.fromLog10(-math.huge))).to.equal(true)
		end)

		it("fromExponential reste exact sous 1e15", function()
			expect(BigNum.fromExponential(5e7, 6, 0).m).to.equal(5e7)
			expect(BigNum.fromExponential(5e7, 6, 3).m).to.equal(5e7 * 216)
		end)

		it("fromExponential bascule en logarithmique au-delà", function()
			local value = BigNum.fromExponential(5e7, 6, 50)
			expect(BigNum.isValid(value)).to.equal(true)
			expect(BigNum.log10(value)).to.be.near(math.log10(5e7) + 50 * math.log10(6), 1e-9)
		end)

		it("ratio pour les barres de progression", function()
			expect(BigNum.ratio(n(50), n(200))).to.be.near(0.25, 1e-12)
			expect(BigNum.ratio(n(0), n(200))).to.equal(0)
		end)
	end)

	describe("validation", function()
		it("rejette les structures invalides", function()
			expect(BigNum.isValid(nil)).to.equal(false)
			expect(BigNum.isValid({ m = 1.5, e = 0 })).to.equal(false)
			expect(BigNum.isValid({ m = 5, e = 1 })).to.equal(false)
			expect(BigNum.isValid({ m = 0 / 0, e = 0 })).to.equal(false)
			expect(BigNum.isValid({ m = 1e15, e = 0 })).to.equal(false)
			expect(BigNum.isValid({ m = 1e14, e = -1 })).to.equal(false)
		end)

		it("sanitize retourne zéro pour une valeur corrompue", function()
			expect(BigNum.isZero(BigNum.sanitize("abc"))).to.equal(true)
			expect(BigNum.sanitize({ m = 12, e = 0 }).m).to.equal(12)
		end)
	end)
end
